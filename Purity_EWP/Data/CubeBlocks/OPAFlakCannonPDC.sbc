				<Model BuildPercentUpperBound="0.67" File="Models\Cubes\large\OPAFlakCannonPDC_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\Cubes\large\OPAFlakCannonPDC_BS3.mwm"/>
			</BuildProgressModels>
		</Definition>
	</CubeBlocks>
