                <MountPoint Side="Right" StartX="0.2" StartY="0.3" EndX="0.5" EndY="2.7"/>
                <MountPoint Side="Right" StartX="2.5" StartY="0.3" EndX="2.8" EndY="2.7"/>
                <MountPoint Side="Right" StartX="0" StartY="1" EndX="3" EndY="2"/>
