; Whether the program should look across connectors
; to detect subgrid thrust
Detect blocks over connectors=false
; Name tag of the reference ship controllers.
; If no name tagged controllers are found
; all ship controllers will be used.
Control seat name tag=Reference
; Name tag of thrusters that the code will ignore
Ignored thrust name tag=Ignore
; If the rotor thrusters will be used as inertial dampeners
Use subgrid thrust as dampeners=true
; This controls how responsive the dampeners are.
; Higher numbers mean quicker response but can
; also lead to oscillations
Dampener scaling factor=50
; Max angle (in degrees) that a thruster can be off
; axis of input direction and still receive maximum
; thrust output
Full burn tolerance angle (deg)=30
; Max angle (in degrees) that a thruster can deviate
; from the desired travel direction and still be
; controlled with movement keys
Max off-axis thrust angle (deg)=90
; Min angle (in degrees) between a thruster's dampening
; direction and desired move direction that is allowed
; for dampener function
Min dampening angle (deg)=75
