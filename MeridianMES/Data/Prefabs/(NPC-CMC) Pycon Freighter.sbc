              <Program>// R e a d m e
// -----------
// 
// In this file you can include any instructions or other comments you want to have injected onto the 
// top of your final script. You can safely delete this file if you do not want any such comments.
// 
IMyShipController reference = null;
List&lt;IMyGyro&gt; Gyros = new List&lt;IMyGyro&gt;();
double Vg = 500;
bool Inited = false;
static double Global_Timestep = 0.01666 * 10;
PID YawPID = new PID(10, 0.1, 10, Global_Timestep);
PID PitchPID = new PID(10, 0.1, 10, Global_Timestep);
PID AltitudePID = new PID(1, 0.5, 0.25, Global_Timestep, 50, -50);
PID GravityPID = new PID(10, 2, 0.25, Global_Timestep);
List&lt;IMyThrust&gt;[] thrusterDir = new List&lt;IMyThrust&gt;[Base6Directions.EnumDirections.Length];
double[] thrusterDirTs = new double[Base6Directions.EnumDirections.Length];
double[] thrusterDirTsMax = new double[Base6Directions.EnumDirections.Length];
Vector3D TargetPosition = Vector3D.Zero;
Vector3D LastGravNorm = Vector3D.Zero;

public Vector3D Velocity
{
    get
    {
        return reference.GetShipVelocities().LinearVelocity;
    }
}
public Vector3D Gravity
{
    get
    {
        if(FirstGravityMag&lt;0) FirstGravityMag = reference.GetNaturalGravity().Length();
        return reference.GetNaturalGravity();
    }
}
public Vector3D Position
{
    get
    {
        return reference.GetPosition();
    }
}
public Vector3D Forward
{
    get
    {
        return reference.WorldMatrix.Forward;
    }
}
public double Mass
{
    get
    {
        return reference.CalculateShipMass().PhysicalMass;
    }
}
public double Altitude
{
    get
    {
        double _Altitude = -1;
        if (reference.TryGetPlanetElevation(MyPlanetElevation.Sealevel, out _Altitude))
        {
            if (FirstAltitudeValue &lt; 0) FirstAltitudeValue = _Altitude;
            return _Altitude;
        }
        return -1;
    }
}
public double FirstAltitudeValue
{
    get; set;
} = -1;
public double FirstGravityMag
{
    get; set;
} = -1;
public Vector3D PlanetPos
{
    get
    {
        Vector3D PlanetPos = Vector3D.Zero;
        if(reference.TryGetPlanetPosition(out PlanetPos)) return PlanetPos;
        return Vector3D.Zero;
    }
}
public Program()
{
    Runtime.UpdateFrequency = UpdateFrequency.Update10;
}

public void Main(string arg, UpdateType updateType = UpdateType.Terminal)
{
    if (updateType != UpdateType.Update10) return;
    if (!Inited &amp;&amp; !(Inited = DoInit())) return;
    if(!Vector3D.IsZero(Gravity)) RunOrbitingNearestPlanet();
}
public bool DoInit()
{
    bool PassInitCheck = false;
    List&lt;IMyThrust&gt; TEMPThruster = new List&lt;IMyThrust&gt;();
    List&lt;IMyShipController&gt; Controllers = new List&lt;IMyShipController&gt;();
    GridTerminalSystem.GetBlocksOfType(Controllers, x =&gt; x.CubeGrid.EntityId == Me.CubeGrid.EntityId &amp;&amp; (reference = x).IsFunctional);
    GridTerminalSystem.GetBlocksOfType(Gyros);
    Gyros = Gyros.FindAll(x =&gt; x.CubeGrid.EntityId == Me.CubeGrid.EntityId);
    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections)
    {
        thrusterDir[(int)dir] = new List&lt;IMyThrust&gt;();
        thrusterDirTs[(int)dir] = 0;
        thrusterDirTsMax[(int)dir] = 0;
    }
    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections)
    {
        Base6Directions.Direction controlledDir = reference.Orientation.TransformDirection(dir);
        GridTerminalSystem.GetBlocksOfType(TEMPThruster, t =&gt; t.CubeGrid == Me.CubeGrid &amp;&amp; t.Orientation.Forward == controlledDir);
        foreach (var thtr in TEMPThruster) thrusterDir.ElementAt((int)dir).Add(thtr);
    }
    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections)
    {
        foreach (var thruster in thrusterDir.ElementAt((int)dir))
        {
            var thrustName = thruster.DetailedInfo;
            double ThrustRatio = 1;
            if (thrustName.Contains("Ion")) ThrustRatio *= 0.3;
            else if (thrustName.Contains("Gravity")) ThrustRatio *= 1.8;
            else if (thrustName.Contains("Atmo")) ThrustRatio = 0;
            thrusterDirTs[(int)dir] += thruster.MaxEffectiveThrust;
            thrusterDirTsMax[(int)dir] += thruster.MaxThrust * ThrustRatio;
        }
    }
    PassInitCheck = reference != null;
    PassInitCheck = PassInitCheck &amp;&amp; Gyros.Count &gt; 0;

    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections) 
    {
        if (thrusterDir.ElementAt((int)dir).Count == 0)
        {
            PassInitCheck = false;
            break;
        }
    }

    return PassInitCheck;
}
void RunOrbitingNearestPlanet()
{
    Vector3D _Gravity = Gravity;
    Vector3D _Velocity = Velocity;
    Vector3D _Position = Position;
    Vector3D NormGravity = Vector3D.Normalize(_Gravity);
    Vector3D ShipForward = Vector3D.Normalize(!Vector3D.IsZero(TargetPosition) ? VectorMath.Rejection(TargetPosition - _Position, NormGravity) : Forward);
    Vector3D PlanetDir = Vector3D.Normalize(PlanetPos - _Position);
    Vector3D OrbitNormal = Vector3D.Normalize(Vector3D.Cross(ShipForward, PlanetDir)) * Math.Sign(ShipForward.Dot(Forward));
    Vector3D OrbitDir = Vector3D.Normalize(Vector3D.Cross(PlanetDir, OrbitNormal));
    Vector3D OrbitCommand = (OrbitDir * Vg - _Velocity) / Global_Timestep;
    Vector3D AltCommand = Vector3D.Zero;
    double AltSpeed = VectorMath.ScalarProjection(_Velocity, -NormGravity);
    double _Altitude = Altitude;
    if (Math.Abs(_Velocity.Length() - Vg) &lt;= 10 &amp;&amp; Math.Round(1 - Vector3D.Dot(ShipForward, OrbitDir), 1) == 0)
    {
        OrbitCommand = VectorMath.Rejection(OrbitCommand, ShipForward);
    }
    if (FirstAltitudeValue &lt; 0)
    {
        Vector3D GravCompensation = -VectorMath.Projection(LastGravNorm - NormGravity, NormGravity) * Vg * Vg;
        var GravityMag = _Gravity.Length();
        var RelGravity = -(FirstGravityMag - GravityMag)*1000;
        var InstantVel_Tangent = -NormGravity * AltSpeed;
        AltCommand = InstantVel_Tangent - NormGravity * GravityPID.Control(RelGravity, Global_Timestep) - _Gravity + GravCompensation;
    }
    else
    {
        var RelAltitude = FirstAltitudeValue - _Altitude;
        var t = Math.Max(Math.Abs(RelAltitude) / Math.Max(Math.Abs(AltSpeed), 1), 1);
        var ZEV = -NormGravity * AltSpeed;
        AltCommand = (ZEV / t) - NormGravity * AltitudePID.Control(RelAltitude, Global_Timestep) - _Gravity;
    }

    ApplyGyroOverride(reference, OrbitDir, _Gravity);
    ApplyThruster(OrbitCommand + AltCommand);
    LastGravNorm = NormGravity;
}
public void ApplyThruster(Vector3D AccelCommand, bool ApplyGyro = true, int Esp = 5)
{
    Vector3D NAccelCommand = Vector3D.Normalize(AccelCommand);
    Vector3D lFrameAccelCmd = -Vector3D.TransformNormal(NAccelCommand, Matrix.Transpose(reference.WorldMatrix)) * Mass;
    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections)
    {
        foreach (var thruster in thrusterDir.ElementAt((int)dir))
        {
            thruster.ThrustOverridePercentage = 0.0f;
        }
    }
    if (Vector3D.IsZero(AccelCommand)) return;
    foreach (Base6Directions.Direction dir in Base6Directions.EnumDirections)
    {
        double FaceThrust = AccelCommand.Length() * Vector3D.Dot(lFrameAccelCmd, Base6Directions.Directions[(int)dir]);
        double FaceMaxEfthrust = thrusterDirTs.ElementAt((int)dir);
        double FaceMaxEfthrustUpdate = 0;
        if (FaceThrust &lt;= 0 || Math.Round(FaceThrust, Esp) == 0) continue;
        foreach (var thruster in thrusterDir.ElementAt((int)dir))
        {
            thruster.ThrustOverride = (float)(FaceThrust * (thruster.MaxEffectiveThrust / FaceMaxEfthrust));
            FaceMaxEfthrustUpdate += thruster.MaxEffectiveThrust;
        }
        thrusterDirTs[(int)dir] = FaceMaxEfthrustUpdate;
    }
}
public bool ApplyGyroOverride(IMyTerminalBlock reference, Vector3D FwdVec, Vector3D _Gravity, bool ShouldAlignG = true, int Esp = 3)
{
    double ShipForwardAzimuth, ShipForwardElevation, ShipForwardRoll = 0;
    double pitchSpeed = 0, yawSpeed = 0;
    Vector3D ShipUp = reference.WorldMatrix.Up;
    Vector3D ShipForward = reference.WorldMatrix.Forward;
    Vector3D ShipLeft = reference.WorldMatrix.Left;
    Quaternion Quat_Two = Quaternion.CreateFromForwardUp(ShipForward, ShipUp);
    Vector3D RCReferenceFrameVector = Vector3D.Transform(Vector3D.Normalize(FwdVec), Quaternion.Inverse(Quat_Two));
    bool InGravity = !Vector3D.IsZero(_Gravity);
    _Gravity.Normalize();
    Vector3D.GetAzimuthAndElevation(RCReferenceFrameVector, out ShipForwardAzimuth, out ShipForwardElevation);
    if (ShouldAlignG &amp;&amp; InGravity &amp;&amp; Math.Round(1 - Vector3D.Dot(_Gravity, ShipUp), 2) != 0)
    {
        Vector3D planetRelativeLeftVec = ShipForward.Cross(_Gravity);
        ShipForwardRoll = -VectorMath.AngleBetween(ShipLeft, planetRelativeLeftVec) * Math.Sign(Vector3D.Dot(ShipLeft, _Gravity));
    }
    if (InGravity &amp;&amp; Math.Round(_Gravity.Dot(ShipForward), 2) != 0)
    {
        ShipForwardElevation = -Math.Acos(_Gravity.Dot(ShipForward)) + Math.PI / 2;
    }
    pitchSpeed = PitchPID.Control(ShipForwardElevation, Global_Timestep);
    yawSpeed = YawPID.Control(ShipForwardAzimuth, Global_Timestep);
    pitchSpeed = Math.Round(ShipForwardElevation, 3);
    yawSpeed = Math.Round(ShipForwardAzimuth, 3);
    var Vector = Vector3.Transform((new Vector3D(pitchSpeed, yawSpeed, ShipForwardRoll)), reference.WorldMatrix.GetOrientation());
    foreach (var gyro in Gyros)
    {
        var TRANS_VECT = Vector3.Transform(Vector, Matrix.Transpose(gyro.WorldMatrix.GetOrientation()));
        if (double.IsNaN(TRANS_VECT.X) || double.IsNaN(TRANS_VECT.Y) || double.IsNaN(TRANS_VECT.Z)) break;
        gyro.Pitch = -TRANS_VECT.X;
        gyro.Yaw = -TRANS_VECT.Y;
        gyro.Roll = -TRANS_VECT.Z;
        gyro.GyroOverride = true;
    }
    return Math.Round(pitchSpeed + yawSpeed, Esp) == 0;
}

public class PID
{
    public double Kp { get; set; } = 0;
    public double Ki { get; set; } = 0;
    public double Kd { get; set; } = 0;
    public double Value { get; private set; }

    double _timeStep = 0;
    double _inverseTimeStep = 0;
    double _errorSum = 0;
    double _lastError = 0;
    double upperLimit_i, lowerLimit_i;
    bool _firstRun = true;

    public PID(double kp, double ki, double kd, double timeStep, double upperLimit=-1, double lowerLimit = -1)
    {
        Kp = kp;
        Ki = ki;
        Kd = kd;
        _timeStep = timeStep;
        _inverseTimeStep = 1 / _timeStep;
        upperLimit_i = upperLimit;
        lowerLimit_i = lowerLimit;
    }

    protected virtual double GetIntegral(double currentError, double errorSum, double timeStep)
    {
        var integral = errorSum + currentError * timeStep;
        integral = (upperLimit_i &gt; 0 &amp;&amp; integral &gt; upperLimit_i ? upperLimit_i : integral);
        integral = (lowerLimit_i &lt; 0 &amp;&amp; integral &lt; lowerLimit_i ? lowerLimit_i : integral);
        return integral;
    }

    public double Control(double error)
    {
        double errorDerivative = (error - _lastError) * _inverseTimeStep;

        if (_firstRun)
        {
            errorDerivative = 0;
            _firstRun = false;
        }
        _errorSum = GetIntegral(error, _errorSum, _timeStep);
        _lastError = error;
        Value = Kp * error + Ki * _errorSum + Kd * errorDerivative;
        return Value;
    }

    public double Control(double error, double timeStep)
    {
        if (timeStep != _timeStep)
        {
            _timeStep = timeStep;
            _inverseTimeStep = 1 / _timeStep;
        }
        return Control(error);
    }

    public virtual void Reset()
    {
        _errorSum = 0;
        _lastError = 0;
        _firstRun = true;
    }
}
public static class VectorMath
{
    public static Vector3D SafeNormalize(Vector3D a)
    {
        if (Vector3D.IsZero(a)) return Vector3D.Zero;
        if (Vector3D.IsUnit(ref a)) return a;
        return Vector3D.Normalize(a);
    }
    public static Vector3D Reflection(Vector3D a, Vector3D b, double rejectionFactor = 1)
    {
        Vector3D project_a = Projection(a, b);
        Vector3D reject_a = a - project_a;
        return project_a - reject_a * rejectionFactor;
    }
    public static Vector3D Rejection(Vector3D a, Vector3D b)
    {
        if (Vector3D.IsZero(a) || Vector3D.IsZero(b)) return Vector3D.Zero;
        return a - a.Dot(b) / b.LengthSquared() * b;
    }
    public static Vector3D Projection(Vector3D a, Vector3D b)
    {
        if (Vector3D.IsZero(a) || Vector3D.IsZero(b)) return Vector3D.Zero;
        return a.Dot(b) / b.LengthSquared() * b;
    }
    public static double ScalarProjection(Vector3D a, Vector3D b)
    {
        if (Vector3D.IsZero(a) || Vector3D.IsZero(b)) return 0;
        if (Vector3D.IsUnit(ref b)) return a.Dot(b);
        return a.Dot(b) / b.Length();
    }
    public static double AngleBetween(Vector3D a, Vector3D b)
    {
        if (Vector3D.IsZero(a) || Vector3D.IsZero(b)) return 0;
        else return Math.Acos(MathHelper.Clamp(a.Dot(b) / Math.Sqrt(a.LengthSquared() * b.LengthSquared()), -1, 1));
    }
    public static double CosBetween(Vector3D a, Vector3D b, bool useSmallestAngle = false)
    {
        if (Vector3D.IsZero(a) || Vector3D.IsZero(b)) return 0;
        else return MathHelper.Clamp(a.Dot(b) / Math.Sqrt(a.LengthSquared() * b.LengthSquared()), -1, 1);
    }
}
